{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PHP Built-in Server",
      "type": "shell",
      "command": "php",
      "args": [
        "-S",
        "localhost:8000",
        "-t",
        "${workspaceFolder}"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "php",
      "args": [
        "${workspaceFolder}/test_bootstrap.php"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Composer Install",
      "type": "shell",
      "command": "composer",
      "args": [
        "install"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

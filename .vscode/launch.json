{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for XDebug",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "/": "${workspaceFolder}"
      }
    },
    {
      "name": "Launch currently open script",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003,
      "pathMappings": {
        "/": "${workspaceFolder}"
      }
    },
    {
      "name": "Run Integration Tests",
      "type": "php",
      "request": "launch",
      "program": "${workspaceFolder}/test_bootstrap.php",
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "pathMappings": {
        "/": "${workspaceFolder}"
      }
    }
  ]
}
